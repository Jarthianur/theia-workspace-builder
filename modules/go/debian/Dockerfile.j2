RUN apt update && apt install -y -qq \
    golang-go && \
    rm -rf /var/lib/apt/lists/*

RUN su - theia -c "go install github.com/fatih/gomodifytags@latest" && \
    su - theia -c "go install github.com/haya14busa/goplay/cmd/goplay@latest" && \
    su - theia -c "go install github.com/josharian/impl@latest" && \
    su - theia -c "go install github.com/cweill/gotests/gotests@latest" && \
    su - theia -c "go install golang.org/x/lint/golint@latest" && \
    su - theia -c "go install honnef.co/go/tools/cmd/staticcheck@latest" && \
    su - theia -c "go install github.com/golangci/golangci-lint/cmd/golangci-lint@latest" && \
    su - theia -c "go install golang.org/x/tools/gopls@latest" && \
    su - theia -c "go install github.com/go-delve/delve/cmd/dlv@latest"
